# Mattermost Server Configuration
MATTERMOST_URL=https://chat.tu-institucion.org/mattermost
MATTERMOST_WS_URL=wss://chat.tu-institucion.org/mattermost/api/v4/websocket
MATTERMOST_HOST_HEADER=chat.tu-institucion.org
MATTERMOST_BOT_TOKEN=tu_bot_token_aqui
MATTERMOST_BOT_USERNAME=thinktank-bot
MATTERMOST_USER_TOKEN=tu_user_personal_access_token_aqui

# Local Inference Engine (LM Studio / vLLM / Ollama)
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=tu_api_key_de_lm_studio
LM_STUDIO_MODEL=openai/gpt-oss-20b

# SOS MCP Gateway (opcional, para herramientas cienciométricas avanzadas)
SOS_MCP_GATEWAY_URL=http://127.0.0.1:8010
